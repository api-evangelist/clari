                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/scorecard?skip=0&limit=50&filterTimeGt=<dateTime>&filterTimeLt=<dateTime>&filterRepId=<string>&filterScorerId=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "scorecard"
              ],
              "query": [
                {
                  "description": "Skip specified number of scorecards. Defaults to 0, if not passed. Should be integer, else returns bad request error.\n",
                  "key": "skip",
                  "value": "0"
                },
                {
                  "description": "Limits the number of scorecards returned to given number. Defaults to 50, if not passed. Should be integer, else returns bad request error.\n",
                  "key": "limit",
                  "value": "50"
                },
                {
                  "description": "If passed, filters out scorecards before passed time.\nUse ISO date-time format, eg: 2020-01-01T00:00:00Z. If invalid value is passed, results in bad request error.\n",
                  "key": "filterTimeGt",
                  "value": "<dateTime>"
                },
                {
                  "description": "If passed, filters out scorecards after passed time.\nUse ISO date-time format, eg: 2020-01-01T00:00:00Z. If invalid value is passed, results in bad request error.\n",
                  "key": "filterTimeLt",
                  "value": "<dateTime>"
                },
                {
                  "description": "This is a single-value parameter, if passed, will filter scorecards for the given user id who is getting scored for the call\n",
                  "key": "filterRepId",
                  "value": "<string>"
                },
                {
                  "description": "This is a single-value parameter, if passed, will filter scorecards for the given user id, who are scoring the calls\n",
                  "key": "filterScorerId",
                  "value": "<string>"
                }
              ]
            },
            "description": "This endpoint allows listing scorecard by different parameters.\nFilter parameters have filter prefix and sort parameters have sort prefix.\nYou can fetch only 100 scorecard in page, use skip and limit to scroll through scorecards."
